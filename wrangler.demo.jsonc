{
  // Public demo: electronics-erp.ahromlabs.com, made-up company, sample data reset nightly
  // (workers/demo-reset-cron). Same code as lstechnologies.in; deploy with `npm run deploy:demo`.
  // Lives in the Ahrom Labs Cloudflare account (where ahromlabs.com is), not LS Technologies'.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ls-inventory-demo",
  "account_id": "5d8cf246f656006b81d99d734e8c0f40",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"], // public fetch: utils/demo.js calls ahromlabs.com (same zone)
  "observability": { "enabled": true },
  "routes": [{ "pattern": "electronics-erp.ahromlabs.com", "custom_domain": true }],
  "placement": { "region": "aws:ap-south-1" },
  // Built with NEXT_PUBLIC_DEMO=1 (made-up names, /demo page, GA): see the deploy:demo script.
  "assets": {
    "directory": "./frontend/out",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/*"]
  },
  // No R2 bucket: the demo refuses uploads (utils/demo.js).
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Secrets (wrangler secret put -c wrangler.demo.jsonc): DEMO_PASS (owner-pass PIN, 4+ characters), TURSO_AUTH_TOKEN (lsdemo group token),
  // SESSION_SECRET (its own, never the live one). Never the live deployment's values.
  "vars": {
    "DEMO_MODE": "1",
    "TURSO_URL": "libsql://ls-demo-pujan.aws-ap-south-1.turso.io",
    "LEADS_TURSO_URL": "libsql://ls-demo-leads-pujan.aws-ap-south-1.turso.io"
  },
  "alias": {
    "pdfkit": "pdfkit/js/pdfkit.standalone.js",
    "qrcode": "qrcode/lib/server.js",
    "iconv-lite": "./shims/iconv-lite.js"
  }
}
