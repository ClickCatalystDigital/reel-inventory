{
  "name": "ls-inventory",
  "version": "1.0.0",
  "description": "Inventory management for electronic components (Cloudflare Workers)",
  "main": "worker.mjs",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:next": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "node scripts/init-db.js",
    "backup": "node scripts/backup-db.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
