{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ls-inventory",
  // Pinned so a deploy can never land in another Cloudflare account.
  "account_id": "bc68703f807482e6facae60ed22a4008",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },

  // Custom domain (zone lstechnologies.in lives in this account). Cloudflare creates the DNS record + certificate on deploy.
  "routes": [
    { "pattern": "lstechnologies.in", "custom_domain": true },
    // alias only: worker.mjs 301-redirects www to the root address
    { "pattern": "www.lstechnologies.in", "custom_domain": true }
  ],

  // Run the Worker next to the Turso database (aws ap-south-1): each request makes several
  // sequential queries, so cutting the Worker<->DB distance matters more than the user<->Worker one.
  "placement": { "region": "aws:ap-south-1" },

  // Static Next.js export. The Worker runs first for everything except /_next/* so it can
  // enforce login + role page rules (worker.mjs); /_next/* is public hashed JS/CSS.
  "assets": {
    "directory": "./frontend/out",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/*"]
  },

  // Private bucket: files are only served through /api/gelco-docs/file (login required).
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "impax-ls" }],

  // 10 login attempts / 60s per IP / Cloudflare location.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  // Not secret. Secrets (set with `wrangler secret put`): TURSO_AUTH_TOKEN, SESSION_SECRET.
  "vars": { "TURSO_URL": "libsql://ls-inventory-clickcatalyst-digital.aws-ap-south-1.turso.io" },

  "alias": {
    // pdfkit's default build reads font files from disk (no disk on Workers); the standalone
    // build has them embedded.
    "pdfkit": "pdfkit/js/pdfkit.standalone.js",
    // default resolution picks qrcode's browser build, which has no PNG toBuffer()
    "qrcode": "qrcode/lib/server.js",
    "iconv-lite": "./shims/iconv-lite.js"
  }
}
